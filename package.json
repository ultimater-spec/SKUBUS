{
  "name": "school-bus-management",
  "version": "1.0.0",
  "description": "",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run preview",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server install",
    "build:all": "npm install && npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
